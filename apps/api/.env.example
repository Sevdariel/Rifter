# Copy to .env for local development. Never commit .env.
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=debug

# Shared bearer for the X-Rifter-Token header (min 16 chars). Required -
# the API refuses to boot without it (fail closed).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_AUTH_TOKEN=
# The dev identity: your own Riot PUUID. Resolved onto authenticated requests.
DEV_PUUID=

# Comma-separated origins allowed to read API responses from a browser.
CORS_ORIGINS=http://localhost:4200

# Wired for the M2 database module; not consumed yet.
DATABASE_URL=postgres://rifter:rifter@localhost:5432/rifter
# Development key from https://developer.riotgames.com (expires every 24h)
RIOT_API_KEY=
# Regional cluster for Match-V5/account-v1 and platform shard for future
# platform APIs. Europe covers EUW/EUNE/TR/RU.
RIOT_REGIONAL_ROUTE=europe
RIOT_PLATFORM_ROUTE=euw1

# Ollama must stay on loopback - non-local URLs fail validation.
OLLAMA_BASE_URL=http://localhost:11434
# Force a model tag and skip VRAM tier selection (e.g. qwen3.5:9b).
# OLLAMA_MODEL=
# Force the free-VRAM figure in MiB - tier selection on hosts without nvidia-smi.
# OLLAMA_FREE_VRAM_MB=
# Enable chain-of-thought capture for analysis debug runs (slower).
OLLAMA_THINK=false

# Report language for the analysis worker (pl|en).
ANALYSIS_LOCALE=pl
# Set false to run the API without the in-process analysis worker.
ANALYSIS_WORKER_ENABLED=true
# Milliseconds between worker claim attempts when the queue is empty.
ANALYSIS_WORKER_POLL_MS=5000

# Failed analysis_jobs older than this are pruned.
JOB_RETENTION_DAYS=30

# Optional; error reporting is off when unset.
SENTRY_DSN=
