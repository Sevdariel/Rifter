# Dependencies and build output
node_modules/
dist/
.angular/
coverage/
target/
**/src-tauri/gen/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
# Local web runtime config override (holds API token / Sentry DSN)
apps/web/public/config.local.json

# Agent local configuration and telemetry
.devin/mcp_config.local.json
.devin/config.local.json
.devin/telemetry/
.devin/tmp/

# Visual references (may contain personal data)
.figma-refs/

