!**/fixtures/**/*.rofl
!**/fixtures/captures/

# Editors and OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local scratch notes
ToDO/
